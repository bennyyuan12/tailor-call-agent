PORT=8787

# Public HTTPS URL that Twilio can reach.
# For local testing, run a tunnel such as localtunnel or ngrok and put that HTTPS URL here.
PUBLIC_BASE_URL=https://your-public-tunnel.example

# Outbound calls stay blocked until this is explicitly true.
ALLOW_OUTBOUND_CALLS=false

OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_VOICE=alloy

# openai uses OpenAI Realtime speech. elevenlabs uses OpenAI for listening/reasoning and ElevenLabs for speech.
AUDIO_OUTPUT_PROVIDER=openai
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_NAME=Mark - Casual, Relaxed and Light
# Optional: set this directly if the voice name search is ambiguous.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=ulaw_8000

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+15551234567

CALLER_NAME=Benny
AGENT_NAME=Benny's AI assistant
CALL_PURPOSE=checking suit alteration price and turnaround time
MAX_CALL_SECONDS=360
MAX_ATTEMPTS_PER_CONTACT=2
